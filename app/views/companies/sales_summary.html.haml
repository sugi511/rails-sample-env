%h1= "#{@company.name} - Sales Summary"

.sales-summary-container
  %h2 Last Month Sales Summary (Customer x Day)

  .ai-chat-section.mb-4
    .card
      .card-header
        %h5.mb-0
          %i.fas.fa-robot.me-2
          AI Sales Analysis
      .card-body
        - if @company.openai_api_key.present?
          .chat-container#chatContainer
            .chat-messages#chatMessages
              .message.ai-message
                .message-content
                  Hello! Please ask me anything about your sales data. Examples: "Who is the highest-selling customer?" "What are the regional sales trends?"
          .chat-input-section
            .input-group
              %input.form-control#messageInput{type: "text", placeholder: "Ask questions about your sales data...", maxlength: "500"}
              %button.btn.btn-primary#sendButton{type: "button"}
                %i.fas.fa-paper-plane.me-1
                Send
            .text-muted.small.mt-1 You can also send by pressing Enter key
            .token-info.mt-2#tokenInfo{style: "display: none;"}
              .alert.alert-info.small.mb-0
                %i.fas.fa-info-circle.me-1
                Check token count and estimated cost before sending
            .token-info.mt-2#tokenInfo{style: "display: none;"}
              .alert.alert-info.small.mb-0
                %i.fas.fa-info-circle.me-1
                Check token count and estimated cost before sending
        - else
          .alert.alert-warning
            %i.fas.fa-exclamation-triangle.me-2
            To use the AI analysis feature, please set your OpenAI API key in
            = link_to "company settings", edit_company_path(@company), class: "alert-link"
            \.

  - if @customers.any?
    .table-responsive
      %table.table.table-striped.table-bordered
        %thead.table-dark
          %tr
            %th Customer Name
            %th Region
            - @sales_data[:weeks].each do |week|
              %th= week[:label]
            %th Total
        %tbody
          - @customers.each do |customer|
            %tr
              %td= customer.name
              %td= customer.region&.name || "Not Set"
              - total = 0
              - @sales_data[:weeks].each do |week|
                - amount = @sales_data[:sales][customer.id][week[:label]]
                - total += amount
                %td.text-end= number_to_currency(amount, unit: "$", precision: 0)
              %td.text-end.fw-bold= number_to_currency(total, unit: "$", precision: 0)
        %tfoot.table-secondary
          %tr
            %td.fw-bold{colspan: 2} Total
            - grand_total = 0
            - @sales_data[:weeks].each do |week|
              - week_total = @customers.sum { |c| @sales_data[:sales][c.id][week[:label]] }
              - grand_total += week_total
              %td.text-end.fw-bold= number_to_currency(week_total, unit: "$", precision: 0)
            %td.text-end.fw-bold= number_to_currency(grand_total, unit: "$", precision: 0)
  - else
    .alert.alert-info
      %p No customers are registered for this company yet.

.mt-4
  = link_to "Back to Company", company_path(@company), class: "btn btn-secondary"
  = link_to "Companies List", companies_path, class: "btn btn-primary ms-2"

:css
  .sales-summary-container {
    margin-top: 20px;
  }

  .table-responsive {
    margin-top: 15px;
  }

  .table th, .table td {
    vertical-align: middle;
    white-space: nowrap;
  }

  .table thead th {
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .text-end {
    text-align: right;
  }

  .fw-bold {
    font-weight: bold;
  }

  /* AI Chat Styles */
  .ai-chat-section {
    background: #f8f9fa;
    border-radius: 8px;
    padding: 0;
  }

  .chat-container {
    max-height: 400px;
    overflow-y: auto;
  }

  .chat-messages {
    min-height: 200px;
    max-height: 300px;
    overflow-y: auto;
    padding: 15px;
    background: white;
    border-radius: 4px;
  }

  .message {
    margin-bottom: 15px;
    display: flex;
    align-items: flex-start;
  }

  .message.user-message {
    justify-content: flex-end;
  }

  .message.ai-message {
    justify-content: flex-start;
  }

  .message-content {
    max-width: 80%;
    padding: 10px 15px;
    border-radius: 18px;
    word-wrap: break-word;
    white-space: pre-wrap;
  }

  .user-message .message-content {
    background: #007bff;
    color: white;
    border-bottom-right-radius: 4px;
  }

  .ai-message .message-content {
    background: #e9ecef;
    color: #333;
    border-bottom-left-radius: 4px;
  }

  .chat-input-section {
    padding: 15px;
    background: white;
    border-top: 1px solid #dee2e6;
  }

  .loading-indicator {
    display: none;
    text-align: center;
    padding: 10px;
    color: #6c757d;
  }

  .loading-indicator.show {
    display: block;
  }

  #messageInput:focus {
    border-color: #007bff;
    box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
  }

  #sendButton:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .token-info {
    font-size: 0.875rem;
  }

  .token-confirmation-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1050;
  }

  .token-confirmation-content {
    background: white;
    border-radius: 8px;
    padding: 20px;
    max-width: 500px;
    width: 90%;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .token-stats {
    background: #f8f9fa;
    border-radius: 4px;
    padding: 15px;
    margin: 15px 0;
  }

  .token-stat-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .token-stat-item:last-child {
    margin-bottom: 0;
    font-weight: bold;
    border-top: 1px solid #dee2e6;
    padding-top: 8px;
  }

  .token-info {
    font-size: 0.875rem;
  }

  .token-confirmation-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1050;
  }

  .token-confirmation-content {
    background: white;
    border-radius: 8px;
    padding: 20px;
    max-width: 500px;
    width: 90%;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

