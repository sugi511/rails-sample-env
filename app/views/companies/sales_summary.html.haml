%h1= "#{@company.name} - Sales Summary"

.sales-summary-container
  %h2 Last Month Sales Summary (Customer x Day)

  .ai-chat-section.mb-4
    .card
      .card-header
        %h5.mb-0
          %i.fas.fa-robot.me-2
          AI売上分析
      .card-body
        - if @company.openai_api_key.present?
          .chat-container#chatContainer
            .chat-messages#chatMessages
              .message.ai-message
                .message-content
                  こんにちは！売上データについて何でもお聞きください。例：「最も売上の高い顧客は？」「地域別の売上傾向は？」
          .chat-input-section
            .input-group
              %input.form-control#messageInput{type: "text", placeholder: "売上データについて質問してください...", maxlength: "500"}
              %button.btn.btn-primary#sendButton{type: "button"}
                %i.fas.fa-paper-plane.me-1
                送信
            .text-muted.small.mt-1 Enter キーでも送信できます
        - else
          .alert.alert-warning
            %i.fas.fa-exclamation-triangle.me-2
            AI分析機能を使用するには、
            = link_to "会社設定", edit_company_path(@company), class: "alert-link"
            でOpenAI API keyを設定してください。

  - if @customers.any?
    .table-responsive
      %table.table.table-striped.table-bordered
        %thead.table-dark
          %tr
            %th Customer Name
            %th Region
            - @sales_data[:weeks].each do |week|
              %th= week[:label]
            %th Total
        %tbody
          - @customers.each do |customer|
            %tr
              %td= customer.name
              %td= customer.region&.name || "Not Set"
              - total = 0
              - @sales_data[:weeks].each do |week|
                - amount = @sales_data[:sales][customer.id][week[:label]]
                - total += amount
                %td.text-end= number_to_currency(amount, unit: "$", precision: 0)
              %td.text-end.fw-bold= number_to_currency(total, unit: "$", precision: 0)
        %tfoot.table-secondary
          %tr
            %td.fw-bold{colspan: 2} Total
            - grand_total = 0
            - @sales_data[:weeks].each do |week|
              - week_total = @customers.sum { |c| @sales_data[:sales][c.id][week[:label]] }
              - grand_total += week_total
              %td.text-end.fw-bold= number_to_currency(week_total, unit: "$", precision: 0)
            %td.text-end.fw-bold= number_to_currency(grand_total, unit: "$", precision: 0)
  - else
    .alert.alert-info
      %p No customers are registered for this company yet.

.mt-4
  = link_to "Back to Company", company_path(@company), class: "btn btn-secondary"
  = link_to "Companies List", companies_path, class: "btn btn-primary ms-2"

:css
  .sales-summary-container {
    margin-top: 20px;
  }

  .table-responsive {
    margin-top: 15px;
  }

  .table th, .table td {
    vertical-align: middle;
    white-space: nowrap;
  }

  .table thead th {
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .text-end {
    text-align: right;
  }

  .fw-bold {
    font-weight: bold;
  }

  /* AI Chat Styles */
  .ai-chat-section {
    background: #f8f9fa;
    border-radius: 8px;
    padding: 0;
  }

  .chat-container {
    max-height: 400px;
    overflow-y: auto;
  }

  .chat-messages {
    min-height: 200px;
    max-height: 300px;
    overflow-y: auto;
    padding: 15px;
    background: white;
    border-radius: 4px;
  }

  .message {
    margin-bottom: 15px;
    display: flex;
    align-items: flex-start;
  }

  .message.user-message {
    justify-content: flex-end;
  }

  .message.ai-message {
    justify-content: flex-start;
  }

  .message-content {
    max-width: 80%;
    padding: 10px 15px;
    border-radius: 18px;
    word-wrap: break-word;
    white-space: pre-wrap;
  }

  .user-message .message-content {
    background: #007bff;
    color: white;
    border-bottom-right-radius: 4px;
  }

  .ai-message .message-content {
    background: #e9ecef;
    color: #333;
    border-bottom-left-radius: 4px;
  }

  .chat-input-section {
    padding: 15px;
    background: white;
    border-top: 1px solid #dee2e6;
  }

  .loading-indicator {
    display: none;
    text-align: center;
    padding: 10px;
    color: #6c757d;
  }

  .loading-indicator.show {
    display: block;
  }

  #messageInput:focus {
    border-color: #007bff;
    box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
  }

  #sendButton:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

:javascript
  document.addEventListener('DOMContentLoaded', function() {
    const messageInput = document.getElementById('messageInput');
    const sendButton = document.getElementById('sendButton');
    const chatMessages = document.getElementById('chatMessages');
    const companyId = #{@company.id};

    if (!messageInput || !sendButton || !chatMessages) {
      return;
    }

    function addMessage(content, isUser = false) {
      const messageDiv = document.createElement('div');
      messageDiv.className = `message ${isUser ? 'user-message' : 'ai-message'}`;

      const contentDiv = document.createElement('div');
      contentDiv.className = 'message-content';
      contentDiv.textContent = content;

      messageDiv.appendChild(contentDiv);
      chatMessages.appendChild(messageDiv);

      // スクロールを最下部に
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function showLoading() {
      const loadingDiv = document.createElement('div');
      loadingDiv.className = 'loading-indicator show';
      loadingDiv.id = 'loadingIndicator';
      loadingDiv.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>分析中...';
      chatMessages.appendChild(loadingDiv);
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function hideLoading() {
      const loadingDiv = document.getElementById('loadingIndicator');
      if (loadingDiv) {
        loadingDiv.remove();
      }
    }

    function sendMessage() {
      const message = messageInput.value.trim();
      if (!message) {
        return;
      }

      // ユーザーメッセージを追加
      addMessage(message, true);

      // 入力フィールドをクリア
      messageInput.value = '';

      // ボタンを無効化
      sendButton.disabled = true;
      messageInput.disabled = true;

      // ローディング表示
      showLoading();

      // APIリクエスト
      fetch(`/companies/${companyId}/analyze_sales`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
        },
        body: JSON.stringify({ message: message })
      })
      .then(response => response.json())
      .then(data => {
        hideLoading();

        if (data.error) {
          addMessage(`エラー: ${data.error}`, false);
        } else {
          addMessage(data.response, false);
        }
      })
      .catch(error => {
        hideLoading();
        console.error('Error:', error);
        addMessage('申し訳ございません。エラーが発生しました。もう一度お試しください。', false);
      })
      .finally(() => {
        // ボタンを有効化
        sendButton.disabled = false;
        messageInput.disabled = false;
        messageInput.focus();
      });
    }

    // イベントリスナー
    sendButton.addEventListener('click', sendMessage);

    messageInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });

    // 初期フォーカス
    messageInput.focus();
  });