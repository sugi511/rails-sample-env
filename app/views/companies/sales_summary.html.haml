  .token-stat-item:last-child {
    margin-bottom: 0;
    font-weight: bold;
    border-top: 1px solid #dee2e6;
    padding-top: 8px;
  }

:javascript
  document.addEventListener('DOMContentLoaded', function() {
    const messageInput = document.getElementById('messageInput');
    const sendButton = document.getElementById('sendButton');
    const chatMessages = document.getElementById('chatMessages');
    const companyId = #{@company.id};

    if (!messageInput || !sendButton || !chatMessages) {
      return;
    }

    function addMessage(content, isUser = false) {
      const messageDiv = document.createElement('div');
      messageDiv.className = `message ${isUser ? 'user-message' : 'ai-message'}`;

      const contentDiv = document.createElement('div');
      contentDiv.className = 'message-content';
      contentDiv.textContent = content;

      messageDiv.appendChild(contentDiv);
      chatMessages.appendChild(messageDiv);

      // スクロールを最下部に
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function showLoading() {
      const loadingDiv = document.createElement('div');
      loadingDiv.className = 'loading-indicator show';
      loadingDiv.id = 'loadingIndicator';
      loadingDiv.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Analyzing...';
      chatMessages.appendChild(loadingDiv);
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function hideLoading() {
      const loadingDiv = document.getElementById('loadingIndicator');
      if (loadingDiv) {
        loadingDiv.remove();
      }
    }

    function sendMessage() {
      const message = messageInput.value.trim();
      if (!message) {
        return;
      }

      // まずトークン数を計算
      estimateTokensAndConfirm(message);
    }

    function estimateTokensAndConfirm(message) {
      // ボタンを一時的に無効化
      sendButton.disabled = true;
      sendButton.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Calculating...';

      // トークン数を計算
      fetch(`/companies/${companyId}/estimate_tokens`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
        },
        body: JSON.stringify({ message: message })
      })
      .then(response => response.json())
      .then(data => {
        if (data.error) {
          alert(`Error: ${data.error}`);
          return;
        }

        // カスタム確認モーダルを表示
        showTokenConfirmationModal(data, message);
      })
      .catch(error => {
        console.error('Token estimation error:', error);
        alert('An error occurred while calculating tokens. Do you want to continue anyway?') && executeAnalysis(message);
      })
      .finally(() => {
        // ボタンを元に戻す
        sendButton.disabled = false;
        sendButton.innerHTML = '<i class="fas fa-paper-plane me-1"></i>Send';
      });
    }

    function executeAnalysis(message) {
      // ユーザーメッセージを追加
      addMessage(message, true);

      // 入力フィールドをクリア
      messageInput.value = '';

      // ボタンを無効化
      sendButton.disabled = true;
      messageInput.disabled = true;

      // ローディング表示
      showLoading();

      // APIリクエスト
      fetch(`/companies/${companyId}/analyze_sales`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
        },
        body: JSON.stringify({ message: message })
      })
      .then(response => response.json())
      .then(data => {
        hideLoading();

        if (data.error) {
          addMessage(`Error: ${data.error}`, false);
        } else {
          addMessage(data.response, false);
        }
      })
      .catch(error => {
        hideLoading();
        console.error('Error:', error);
        addMessage('Sorry, an error occurred. Please try again.', false);
      })
      .finally(() => {
        // ボタンを有効化
        sendButton.disabled = false;
        messageInput.disabled = false;
        messageInput.focus();
      });
    }

    // イベントリスナー
    sendButton.addEventListener('click', sendMessage);

    messageInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });

    function showTokenConfirmationModal(tokenData, message) {
      // モーダルHTML作成
      const modalHtml = `
        <div class="token-confirmation-modal" id="tokenModal">
          <div class="token-confirmation-content">
            <h5 class="mb-3">
              <i class="fas fa-calculator me-2 text-primary"></i>
              Confirm AI Analysis Execution
            </h5>
            <p class="mb-3">Do you want to execute AI analysis with the following content?</p>

            <div class="token-stats">
              <div class="token-stat-item">
                <span>Message Type:</span>
                <span class="text-info fw-bold">${tokenData.message_type || 'Normal'}</span>
              </div>
              <div class="token-stat-item">
                <span>Estimated Tokens:</span>
                <span class="text-primary fw-bold">${tokenData.estimated_tokens.toLocaleString()} tokens</span>
              </div>
              <div class="token-stat-item">
                <span>Estimated Cost:</span>
                <span class="text-success fw-bold">$${tokenData.estimated_cost}</span>
              </div>
            </div>

            <div class="alert alert-warning small mb-3">
              <i class="fas fa-exclamation-triangle me-1"></i>
              ※This is an estimated value. Actual values may vary slightly.
            </div>

            <div class="d-flex justify-content-end gap-2">
              <button type="button" class="btn btn-secondary" id="cancelTokenBtn">
                <i class="fas fa-times me-1"></i>
                Cancel
              </button>
              <button type="button" class="btn btn-primary" id="confirmTokenBtn" data-message="${message.replace(/"/g, '&quot;')}">
                <i class="fas fa-check me-1"></i>
                Execute
              </button>
            </div>
          </div>
        </div>
      `;

      // モーダルを表示
      document.body.insertAdjacentHTML('beforeend', modalHtml);

      // イベントリスナーを追加
      document.getElementById('cancelTokenBtn').addEventListener('click', closeTokenModal);
      document.getElementById('confirmTokenBtn').addEventListener('click', function() {
        const message = this.getAttribute('data-message');
        closeTokenModal();
        executeAnalysis(message);
      });
    }

    function closeTokenModal() {
      const modal = document.getElementById('tokenModal');
      if (modal) {
        modal.remove();
      }
    }

    // 初期フォーカス
    messageInput.focus();
  });