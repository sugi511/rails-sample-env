- if notice
  .alert.alert-success.alert-dismissible.fade.show
    = notice
    %button.btn-close{type: "button", "data-bs-dismiss": "alert"}

.d-flex.justify-content-between.align-items-center.mb-4
  %h1.mb-0= @company.name
  .btn-group
    = link_to 'Sales Summary', sales_summary_company_path(@company), class: 'btn btn-info'
    = link_to 'Edit', edit_company_path(@company), class: 'btn btn-primary'
    = link_to 'Back', companies_path, class: 'btn btn-secondary'

.row
  .col-md-6
    .card
      .card-header
        %h5.card-title.mb-0 Basic Information
      .card-body
        %dl.row
          %dt.col-sm-4 Company ID:
          %dd.col-sm-8= @company.id
          %dt.col-sm-4 Company Name:
          %dd.col-sm-8= @company.name
          %dt.col-sm-4 Created:
          %dd.col-sm-8= @company.created_at.strftime("%B %d, %Y")
          %dt.col-sm-4 Updated:
          %dd.col-sm-8= @company.updated_at.strftime("%B %d, %Y")

  .col-md-6
    .card
      .card-header
        %h5.card-title.mb-0 Statistics
      .card-body
        .row.text-center
          .col-6.mb-3
            .border.rounded.p-3
              %h3.text-primary= @company.users.count
              %small.text-muted Users
          .col-6.mb-3
            .border.rounded.p-3
              %h3.text-success= @company.customers.count
              %small.text-muted Customers
          .col-6.mb-3
            .border.rounded.p-3
              %h3.text-info= @company.questions.count
              %small.text-muted Questions
          .col-6.mb-3
            .border.rounded.p-3
              %h3.text-warning= @company.surveys.count
              %small.text-muted Surveys

.row.mt-4
  .col-12
    .card
      .card-header
        %h5.card-title.mb-0 Related Data
      .card-body
        .row
          .col-md-3.mb-2
            = link_to company_users_path(@company), class: 'btn btn-outline-primary w-100'
              %i.fas.fa-users.me-2
              Manage Users
          .col-md-3.mb-2
            = link_to company_customers_path(@company), class: 'btn btn-outline-success w-100'
              %i.fas.fa-user-friends.me-2
              Manage Customers
          .col-md-3.mb-2
            = link_to company_questions_path(@company), class: 'btn btn-outline-info w-100'
              %i.fas.fa-question-circle.me-2
              Manage Questions
          .col-md-3.mb-2
            = link_to company_surveys_path(@company), class: 'btn btn-outline-warning w-100'
              %i.fas.fa-poll.me-2
              Manage Surveys
